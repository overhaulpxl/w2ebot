
# PostgreSQL (Supabase) Connection Pool URL
DATABASE_URL=postgres://[user]:[password]@[host]:6543/postgres?pgbouncer=true

# Konfigurasi Token Bot Utama (RPG & AI)
DISCORD_TOKEN=YOUR_DISCORD_TOKEN_HERE
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
ALLOWED_SERVER_ID=887968847842402355

# Konfigurasi Prefix Bot (Default: w!)
BOT_PREFIX=w!
DATABASE_PATH=./w2ebot.db
STAGING_MODE=false
STAGING_GUILD_ID=

# Phase 9A dashboard safety. Secrets remain server-side and are never browser variables.
DASHBOARD_PUBLIC_URL=
DASHBOARD_DISCORD_CLIENT_ID=
DASHBOARD_DISCORD_CLIENT_SECRET=
DASHBOARD_INTERNAL_KEY_ID=
DASHBOARD_INTERNAL_SIGNING_KEY=
DASHBOARD_SESSION_KEY_ID=
DASHBOARD_SESSION_HASH_KEY=
DASHBOARD_IP_HASH_KEY=
ALLOWED_ORIGINS=

# Konfigurasi Deal System Phase
DEAL_SYSTEM_PHASE=9

# Economy V1 Phase 1/2 foundation (production cutover tetap nonaktif)
ECONOMY_V1_ENABLED=true
ECONOMY_PHASE2_ENABLED=true
ECONOMY_PHASE3_ENABLED=true
ECONOMY_PHASE4_ENABLED=true
ECONOMY_PHASE5_ENABLED=true
ECONOMY_PHASE6_ENABLED=true
ECONOMY_PHASE7_ENABLED=true
ECONOMY_PHASE8_ENABLED=true
ECONOMY_BACKUP_DIR=./backups/economy
ECONOMY_REPORT_DIR=./reports/economy
ECONOMY_MINT_WHITELIST=
ECONOMY_MAX_AMOUNT=9000000000000000
ECONOMY_CONFIRM_TIMEOUT_SECONDS=120
ECONOMY_LARGE_MINT_ETM=
ECONOMY_LARGE_MINT_ECY=
ECONOMY_LARGE_REMOVE_ETM=
ECONOMY_LARGE_REMOVE_ECY=
ECONOMY_LARGE_GRANT_ETM=
ECONOMY_LARGE_GRANT_ECY=
ECONOMY_SEED_ETM_GENERAL=0
ECONOMY_SEED_ETM_BOSS_DUNGEON=0
ECONOMY_SEED_ETM_EVENT=0
ECONOMY_SEED_ECY_GENERAL=0
ECONOMY_SEED_ECY_GIVEAWAY=0
ECONOMY_SEED_ECY_CASINO=0
ECONOMY_SEED_ECY_MARKET=0
ECONOMY_SEED_ECY_MINING=0
