# Konfigurasi Token Bot Utama (RPG & AI)
DISCORD_TOKEN=your_bot_token_here
GEMINI_API_KEY=your_gemini_api_key_here

# Konfigurasi Token Music Bot (Basic & Premium)
MUSIC_BOT_TOKEN=your_music_bot_token_here
CUSTOM_MUSIC_BOT_TOKEN=your_custom_music_bot_token_here

# (Opsional) Pisahkan prefix agar bot reguler dan premium tidak bertabrakan
CUSTOM_MUSIC_BOT_PREFIX=?

# Konfigurasi Spotify (Wajib diisi agar fitur playlist/track Spotify berfungsi)
# Dapatkan dari: https://developer.spotify.com/dashboard
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
